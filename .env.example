# Development-only defaults. Do not reuse these credentials in production.
POSTGRES_DB=bkp
POSTGRES_USER=bkp
POSTGRES_PASSWORD=bkp_development
BKP_DATABASE_URL=postgresql+psycopg://bkp:bkp_development@localhost:5432/bkp
BKP_ENVIRONMENT=development
BKP_LOG_LEVEL=INFO
BKP_LOG_JSON=false
BKP_CORS_ORIGINS=["http://localhost:5173"]
BKP_EXTERNAL_API_TIMEOUT_SECONDS=15
BKP_EXTERNAL_API_MAX_ATTEMPTS=3
BKP_EXTERNAL_API_BACKOFF_SECONDS=0.5
BKP_EXTERNAL_API_USER_AGENT=bio-knowledge-platform/0.7.0
BKP_NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
BKP_NCBI_TOOL=bio_knowledge_platform
# Required for NCBI imports so requests comply with NCBI identification guidance.
BKP_NCBI_EMAIL=researcher@example.org
# Optional. Configure when higher NCBI request limits are needed.
BKP_NCBI_API_KEY=
BKP_UNIPROT_BASE_URL=https://rest.uniprot.org
# Server-side only. New literature write endpoints are disabled when this is empty.
BKP_ADMIN_API_TOKEN=
BKP_GRAPH_TIMEOUT_MS=1500
BKP_FIXTURE_PATH=data/fixtures/phase1_demo.json
VITE_API_BASE_URL=http://localhost:8000/api/v1
